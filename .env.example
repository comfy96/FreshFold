# Database connection used by the app (PRD schema)
DATABASE_URL=

# Direct connection used by migrations (PRD schema)
DIRECT_URL=

# Gemini API key for embeddings and language model (Proposed)
GEMINI_API_KEY=

# In-app payment switch, off by default (Proposed, from PRD A5)
PAYMENTS_ENABLED=

# Payment gateway server key (Test mode only, only if D-2 is approved)
GATEWAY_SECRET_KEY=

# Secret for gateway webhook validation (Only if D-2 is approved)
GATEWAY_WEBHOOK_SECRET=
